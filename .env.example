# Discord application bot token. Keep this secret.
DISCORD_TOKEN=replace-me

# Helix instance this bot should use.
HELIX_BASE_URL=https://your.helix.url

# Persistent bot database inside the container.
HELIXBOT_DB_PATH=/data/helixbot.sqlite3

# Optional: set to a Discord guild/server ID while developing so slash-command
# changes sync immediately to that server. Leave blank for global commands.
DISCORD_DEV_GUILD_ID=


# Default Discord playback volume. 0.10 = 10%. Range: 0.0 to 1.0. (This prevents ear-rape)
HELIXBOT_VOLUME=0.1

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
